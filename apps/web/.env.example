# Copy to .env.local. Only NEXT_PUBLIC_APP_URL is required until later tasks tighten the schema
# (see packages/config/src/env.ts). Never point local/preview envs at production R2 or Stripe.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_URL=http://localhost:8787
# Supabase Auth (T05, docs/AUTH.md). Local values: `supabase status --workdir infra`. Required on
# Vercel production/preview; without them locally the app runs signed-out only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL and GUEST_CAPABILITY_PEPPER are required at use by DB-backed/guest routes (T06/T10):
# a missing value fails that request with a logged 500, builds still pass. Pepper ≥32 chars,
# e.g. $(openssl rand -base64 48 | tr -d '/+=').
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
GUEST_CAPABILITY_PEPPER=
# Optional dedicated pepper (≥32 chars) for rate-limit keys; falls back to GUEST_CAPABILITY_PEPPER.
# RATE_LIMIT_PEPPER=
# Optional Cloudflare Turnstile bot challenge (FR-A05); enforced only when the secret is set.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Keyring `kid:secret[,kid:secret]`, first entry signs (ADR-001). e.g. dev:$(openssl rand -hex 32)
MEDIA_TOKEN_SECRET=
# R2 S3-API credentials, server-side only, used by the upload endpoints (T10; required at use).
# Use the token scoped to the dev originals bucket (see infra/cloudflare/README.md, docs/UPLOADS.md).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ORIGINALS=lumra-originals-dev
# Optional S3 endpoint override (local fake / jurisdiction endpoint).
# R2_ENDPOINT=
# Optional: kick the job worker right after an upload finalizes (POST {WORKER_URL}/internal/relay).
# Both unset ⇒ no kick; the worker's per-minute outbox cron still processes uploads.
# WORKER_URL=http://localhost:8787
# WORKER_KICK_SECRET=   # ≥32 chars, same value as the worker secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
# Observability (T04). Leave the DSNs empty locally: Sentry stays disabled and builds still pass.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
LOG_LEVEL=debug
# Build-time only (Vercel/CI), for source map upload. Never commit a real token.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
