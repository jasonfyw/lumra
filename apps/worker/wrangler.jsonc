{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lumra-worker",
  "account_id": "307ee78e730439ad9485961695203b86",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // postgres.js needs node:net/tls shims (Hyperdrive / DATABASE_URL).
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "lumra-jobs-dev" }],
    "consumers": [
      {
        "queue": "lumra-jobs-dev",
        // Small batches, flushed after 1 s: jobs run concurrently (one per processor slot).
        "max_batch_size": 4,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "lumra-jobs-dlq-dev",
      },
      {
        // `delivery.served` events from apps/media-gateway → usage_ledger (T27). Large batches:
        // one ledger INSERT per batch; idempotent per event dedupeKey, so retries are safe.
        "queue": "lumra-usage-dev",
        "max_batch_size": 100,
        "max_batch_timeout": 10,
        "max_retries": 10,
        "dead_letter_queue": "lumra-usage-dlq-dev",
      },
    ],
  },
  // Gallery access state (`gallery:{id}`) read by the media gateway (ADR-001), written by the
  // gallery.access_changed / gallery.delete handlers. Must be the SAME namespace as
  // apps/media-gateway's ACCESS_STATE: before the first deploy create it once
  // (`wrangler kv namespace create lumra-access-state-dev`) and put its `id` in both configs
  // (T38) — otherwise auto-provisioning gives each Worker its own empty namespace.
  "kv_namespaces": [{ "binding": "ACCESS_STATE" }],
  "r2_buckets": [
    { "binding": "ORIGINALS", "bucket_name": "lumra-originals-dev" },
    { "binding": "DERIVATIVES", "bucket_name": "lumra-derivatives-dev" },
    { "binding": "ARCHIVES", "bucket_name": "lumra-temp-archives-dev" },
  ],
  // Supabase Postgres via Hyperdrive (pooled, Workers-friendly). Create with
  //   wrangler hyperdrive create lumra-db-dev --connection-string="postgres://..."
  // and replace the placeholder id. `localConnectionString` is used by `wrangler dev`.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    },
  ],
  // Image processor (ADR-002): Cloudflare Containers image built from apps/image-processor.
  // Run `pnpm --filter @lumra/image-processor build` before `wrangler deploy` (the Dockerfile
  // copies dist/). Locally, set PROCESSOR_URL instead and run the container with Docker.
  "containers": [
    {
      "class_name": "ImageProcessorContainer",
      "image": "../image-processor/Dockerfile",
      "image_build_context": "../image-processor",
      "instance_type": "standard-1",
      "max_instances": 4,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "IMAGE_PROCESSOR", "class_name": "ImageProcessorContainer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ImageProcessorContainer"] }],
  // Every minute: outbox relay (polls ~50 s per tick). */15 and nightly: reconcilers (T13).
  // Hourly at :07: storage GB-month accrual into usage_ledger (T27, STORAGE_ACCRUAL_CRON).
  // Top-level triggers are inherited by env.production.
  "triggers": { "crons": ["* * * * *", "*/15 * * * *", "7 * * * *", "17 3 * * *"] },
  // Secrets: DATABASE_URL (local only), SENTRY_DSN, WORKER_KICK_SECRET (enables the
  // `POST /internal/relay` finalize kick; same value as the web app). Vars: PROCESSOR_URL (local).
  // Optional vars (T04): SENTRY_ENVIRONMENT, LOG_LEVEL, COMMIT_SHA (`--var COMMIT_SHA:<sha>`)
  "upload_source_maps": true,
  // Production (`wrangler deploy --env production`). Bindings are not inherited, so they are
  // repeated here; KV id is shared with apps/media-gateway's production ACCESS_STATE.
  "env": {
    "production": {
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "lumra-jobs" }],
        "consumers": [
          {
            "queue": "lumra-jobs",
            // Small batches, flushed after 1 s: jobs run concurrently (one per processor slot).
            "max_batch_size": 4,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "dead_letter_queue": "lumra-jobs-dlq",
          },
          {
            // `delivery.served` events from apps/media-gateway → usage_ledger (T27).
            "queue": "lumra-usage",
            "max_batch_size": 100,
            "max_batch_timeout": 10,
            "max_retries": 10,
            "dead_letter_queue": "lumra-usage-dlq",
          },
        ],
      },
      "kv_namespaces": [{ "binding": "ACCESS_STATE", "id": "411b68f7b8da4404ac02dc09ca186ecd" }],
      "r2_buckets": [
        { "binding": "ORIGINALS", "bucket_name": "lumra-originals" },
        { "binding": "DERIVATIVES", "bucket_name": "lumra-derivatives" },
        { "binding": "ARCHIVES", "bucket_name": "lumra-temp-archives" },
      ],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "57fc2b98a702423a9bea23c5f79c96d0" }],
      "containers": [
        {
          "class_name": "ImageProcessorContainer",
          "image": "../image-processor/Dockerfile",
          "image_build_context": "../image-processor",
          "instance_type": "standard-1",
          "max_instances": 4,
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "IMAGE_PROCESSOR", "class_name": "ImageProcessorContainer" }],
      },
    },
  },
}
