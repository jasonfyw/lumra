{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lumra-media-gateway",
  "account_id": "307ee78e730439ad9485961695203b86",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // APP_ORIGIN: comma-separated CORS allow-list (exact origins, never `*`).
  "vars": { "APP_ORIGIN": "http://localhost:3000" },
  // Buckets stay private; this Worker is the only read path (PRD §6.1, ADR-001).
  "r2_buckets": [
    { "binding": "ORIGINALS", "bucket_name": "lumra-originals-dev" },
    { "binding": "DERIVATIVES", "bucket_name": "lumra-derivatives-dev" },
    { "binding": "ARCHIVES", "bucket_name": "lumra-temp-archives-dev" },
  ],
  // Gallery access state (`gallery:{id}`), written by the web app (ADR-001). Namespace ids are
  // provisioned on first deploy / filled in by T38; local dev uses a Miniflare namespace.
  "kv_namespaces": [{ "binding": "ACCESS_STATE" }],
  // Secrets (set with `wrangler secret put`):
  //   MEDIA_TOKEN_SECRET — verification keyring `kid:secret[,kid:secret]` (ADR-001); local dev
  //                        reads it from `.dev.vars`.
  //   SENTRY_DSN
  // Optional vars (T04): SENTRY_ENVIRONMENT, LOG_LEVEL, COMMIT_SHA (`--var COMMIT_SHA:<sha>`)
  "upload_source_maps": true,
  "env": {
    "staging": {
      // TODO(T38): set to the stable staging branch alias once the Vercel project exists.
      "vars": { "APP_ORIGIN": "https://staging.lumra.invalid" },
      "r2_buckets": [
        { "binding": "ORIGINALS", "bucket_name": "lumra-originals-staging" },
        { "binding": "DERIVATIVES", "bucket_name": "lumra-derivatives-staging" },
        { "binding": "ARCHIVES", "bucket_name": "lumra-temp-archives-staging" },
      ],
      "kv_namespaces": [{ "binding": "ACCESS_STATE" }],
    },
    "production": {
      // Canonical app origin is www.lumra.photos (apex 308s to www); lumra-ten.vercel.app is kept
      // during the domain transition.
      //
      // Served on the Workers custom domain media.lumra.photos (jasonfyw/lumra#83), where the
      // Cache API works and previews are edge-cached after authorization (ADR-001). Deploying this
      // requires the `lumra.photos` zone to be ACTIVE on Cloudflare (nameservers switched);
      // `wrangler deploy --env production` fails while the zone is pending. Wrangler creates the
      // proxied DNS record and certificate for the custom domain itself — do not add one by hand.
      // workers_dev stays on during the transition so already-issued workers.dev URLs keep working
      // (no edge cache there: X-Lumra-Cache: BYPASS). Turn it off once NEXT_PUBLIC_MEDIA_URL points
      // at media.lumra.photos everywhere.
      //
      // Never enable Workers Caching (`"cache": { "enabled": true }`): it caches in front of the
      // Worker and would serve media without authorization.
      "routes": [{ "pattern": "media.lumra.photos", "custom_domain": true }],
      "workers_dev": true,
      "vars": {
        "APP_ORIGIN": "https://www.lumra.photos,https://lumra.photos,https://lumra-ten.vercel.app",
      },
      "r2_buckets": [
        { "binding": "ORIGINALS", "bucket_name": "lumra-originals" },
        { "binding": "DERIVATIVES", "bucket_name": "lumra-derivatives" },
        { "binding": "ARCHIVES", "bucket_name": "lumra-temp-archives" },
      ],
      "kv_namespaces": [{ "binding": "ACCESS_STATE", "id": "411b68f7b8da4404ac02dc09ca186ecd" }],
    },
  },
}
